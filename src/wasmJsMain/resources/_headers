# Load speed (2026-11-28): the main Wasm module is served under a
# content-hash filename (it changes every build), so it can be cached
# forever — a new build gets a new URL. qrmaster.js and index.html keep
# Cloudflare's default revalidation (max-age=0) so deploys land at once.
/*.wasm
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=2592000

/icon-192.png
  Cache-Control: public, max-age=2592000

/icon-512.png
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/logo-mark.png
  Cache-Control: public, max-age=2592000

/og-image.png
  Cache-Control: public, max-age=2592000

/bgmodel/resources.json
  Cache-Control: public, max-age=86400

/bgmodel/*
  Cache-Control: public, max-age=31536000, immutable

/bglib/*
  Cache-Control: public, max-age=2592000

/faceapi/*
  Cache-Control: public, max-age=2592000
